{
    "name": "arceus",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "description": "Monorepo for the cdk-glue-iceberg-table package plus a CDK demo app that dogfoods it.",
    "author": "Rodrigo Carvajal",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ksco92/arceus.git"
    },
    "homepage": "https://github.com/ksco92/arceus#readme",
    "bugs": {
        "url": "https://github.com/ksco92/arceus/issues"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspace cdk-glue-iceberg-table",
        "test": "npm run test --workspace cdk-glue-iceberg-table && jest",
        "test:package": "npm run test --workspace cdk-glue-iceberg-table",
        "test:demo": "jest",
        "lint": "npm run lint --workspace cdk-glue-iceberg-table && eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings=0 --fix --ignore-pattern '**/*.d.ts'",
        "cdk": "cdk",
        "deploy": "cdk deploy --require-approval=never",
        "clean": "rm -rf node_modules package-lock.json build cdk.out dist && npm run clean --workspace cdk-glue-iceberg-table"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "aws-cdk": "^2.1145.0",
        "aws-cdk-lib": "^2.273.0",
        "constructs": "^10.8.1",
        "eslint": "^10.13.0",
        "eslint-plugin-jest": "^29.17.0",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3"
    },
    "engines": {
        "node": ">=22.14"
    }
}
