{
    "name": "cdk-glue-iceberg-table",
    "version": "0.1.7",
    "license": "MIT",
    "description": "CDK L2 construct for Apache Iceberg tables in the AWS Glue Data Catalog.",
    "author": "Rodrigo Carvajal",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ksco92/arceus.git"
    },
    "homepage": "https://github.com/ksco92/arceus#readme",
    "bugs": {
        "url": "https://github.com/ksco92/arceus/issues"
    },
    "keywords": [
        "aws",
        "cdk",
        "aws-cdk",
        "glue",
        "iceberg",
        "apache-iceberg",
        "data-lake",
        "construct"
    ],
    "main": "dist/lib/iceberg/index.js",
    "types": "dist/lib/iceberg/index.d.ts",
    "files": [
        "dist/lib/iceberg/**/*.js",
        "dist/lib/iceberg/**/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "watch": "tsc -p tsconfig.build.json -w",
        "test": "jest",
        "cdk": "cdk",
        "deploy": "cdk deploy --require-approval=never",
        "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings=0 --fix --ignore-pattern '**/*.d.ts'",
        "clean": "rm -rf node_modules package-lock.json build cdk.out dist",
        "dev": "npm run clean && npm i && npm run lint && npm run build && npm run test",
        "prepublishOnly": "npm run build && npm test"
    },
    "peerDependencies": {
        "@aws-cdk/aws-glue-alpha": "^2.210.0-alpha.0",
        "aws-cdk-lib": "^2.210.0",
        "constructs": "^10.0.0"
    },
    "devDependencies": {
        "@aws-cdk/aws-glue-alpha": "^2.210.0-alpha.0",
        "@eslint/js": "^9.27.0",
        "@types/jest": "^29.5.14",
        "@types/node": "22.7.9",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "aws-cdk": "^2.1024.0",
        "aws-cdk-lib": "^2.210.0",
        "constructs": "^10.0.0",
        "eslint": "^9.27.0",
        "eslint-plugin-jest": "^28.0.0",
        "globals": "^15.0.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "~5.6.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
