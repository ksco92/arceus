{
    "name": "cdk-glue-iceberg-table",
    "version": "0.5.1",
    "license": "MIT",
    "description": "AWS CDK L2 construct to create and evolve Apache Iceberg tables in the AWS Glue Data Catalog — schema and partition changes that survive CloudFormation updates, via cdk deploy.",
    "stability": "experimental",
    "author": {
        "name": "Rodrigo Carvajal"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ksco92/arceus.git",
        "directory": "packages/cdk-glue-iceberg-table"
    },
    "homepage": "https://github.com/ksco92/arceus#readme",
    "bugs": {
        "url": "https://github.com/ksco92/arceus/issues"
    },
    "keywords": [
        "aws",
        "aws-cdk",
        "awscdk",
        "cdk",
        "cloudformation",
        "glue",
        "glue-data-catalog",
        "iceberg",
        "apache-iceberg",
        "data-catalog",
        "data-lake",
        "lakehouse",
        "schema-evolution",
        "data-engineering",
        "l2-construct"
    ],
    "main": "dist/lib/iceberg/index.js",
    "types": "dist/lib/iceberg/index.d.ts",
    "files": [
        "dist/lib/iceberg/**/*.js",
        "dist/lib/iceberg/**/*.d.ts",
        ".jsii",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "jsii --silence-warnings=reserved-word",
        "watch": "jsii -w --silence-warnings=reserved-word",
        "package": "jsii-pacmak",
        "package:python": "jsii-pacmak -t python",
        "test": "jest",
        "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings=0 --fix --ignore-pattern '**/*.d.ts'",
        "clean": "rm -rf node_modules build dist .jsii tsconfig.json",
        "prepublishOnly": "npm run build && npm test"
    },
    "peerDependencies": {
        "@aws-cdk/aws-glue-alpha": "^2.258.1-alpha.0",
        "aws-cdk-lib": "^2.258.1",
        "constructs": "^10.0.0"
    },
    "devDependencies": {
        "@aws-cdk/aws-glue-alpha": "^2.258.1-alpha.0",
        "@eslint/js": "^9.27.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.13.2",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "aws-cdk-lib": "^2.258.1",
        "constructs": "^10.0.0",
        "eslint": "^9.27.0",
        "eslint-plugin-jest": "^28.0.0",
        "globals": "^15.0.0",
        "jest": "^29.7.0",
        "jsii": "^5.8.0",
        "jsii-pacmak": "^1.112.0",
        "ts-jest": "^29.2.5",
        "typescript": "~5.6.3"
    },
    "engines": {
        "node": ">=22.14"
    },
    "publishConfig": {
        "access": "public"
    },
    "jsii": {
        "outdir": "dist/jsii",
        "versionFormat": "short",
        "tsc": {
            "outDir": "dist",
            "rootDir": "."
        },
        "excludeTypescript": [
            "test"
        ],
        "targets": {
            "python": {
                "distName": "cdk-glue-iceberg-table",
                "module": "cdk_glue_iceberg_table"
            }
        }
    }
}
